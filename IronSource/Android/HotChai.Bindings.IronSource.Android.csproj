<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android36.0</TargetFramework>
		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsTrimmable>false</IsTrimmable>
		<Version>9.6.1-alpha3</Version>
		<Title>$(AssemblyName)</Title>
		<RepositoryUrl>https://github.com/hotchaipro/HotChai.Bindings</RepositoryUrl>
		<Authors>David Taylor</Authors>
		<Company>Hot Chai Games</Company>
		<Description>.NET for Android bindings for the ironSource SDK</Description>
		<PackageProjectUrl>https://github.com/hotchaipro/HotChai.Bindings</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageOutputPath>$(SolutionDir)..\..\LocalPackages\</PackageOutputPath>
		<NoWarn>$(NoWarn);BG8605;BG8606</NoWarn>
	</PropertyGroup>
	<!--
		Bindings for the first-level dependencies of the SDK and adapter artifacts in
		NativeDependencies (see build.gradle). Their own dependencies flow through NuGet.
	-->
	<ItemGroup>
		<PackageReference Include="HotChai.Bindings.Android.Tools.DesugarJdkLibs" Version="2.1.5" />
		<PackageReference Include="HotChai.Bindings.Protobuf.Kotlin.Lite" Version="4.33.1" />
		<PackageReference Include="Square.OkHttp3" Version="5.5.0" />
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.1" />
		<PackageReference Include="Xamarin.AndroidX.DataStore" Version="1.2.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.6" />
		<PackageReference Include="Xamarin.AndroidX.Startup.StartupRuntime" Version="1.2.0.8" />
		<PackageReference Include="Xamarin.AndroidX.WebKit" Version="1.17.1" />
		<PackageReference Include="Xamarin.AndroidX.Work.Work.Runtime.Ktx" Version="2.12.0" />
		<PackageReference Include="Xamarin.Google.Android.Libraries.Ads.Mobile.Sdk" Version="1.5.0" />
		<PackageReference Include="Xamarin.GooglePlayServices.Ads.Identifier" Version="118.3.0.3" />
		<PackageReference Include="Xamarin.GooglePlayServices.AppSet" Version="116.1.0.11" />
		<PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.12.0" />
		<PackageReference Include="Xamarin.GooglePlayServices.CroNet" Version="118.1.1.4" />
		<PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="2.4.0.1" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.11.0.1" />
		<PackageReference Include="Xamarin.KotlinX.Serialization.Core.Jvm" Version="1.11.0.1" />
		<PackageReference Include="Xamarin.KotlinX.Serialization.Json.Jvm" Version="1.11.0.1" />
		<PackageReference Include="Xamarin.Protobuf.JavaLite" Version="4.35.1.1" />
	</ItemGroup>
	<ItemGroup>
		<None Include="build.gradle" />
		<ProguardConfiguration Include="proguard.cfg" />
	</ItemGroup>
	<ItemGroup>
		<AndroidLibrary Update="NativeDependencies\**" Bind="false" />
		<AndroidLibrary Update="NativeDependencies\mediation-sdk-*.aar" Bind="true" />
	</ItemGroup>
	<ItemGroup>
		<AndroidNamespaceReplacement Include="unity3d" Replacement="Unity3D" />
	</ItemGroup>

	<!--
		Keep imported native libraries out of the binding AAR.

		In a library project, the Android SDK adds every .so it extracts from referenced AARs
		(the NativeDependencies companions and AARs from NuGet dependencies such as AndroidX
		DataStore) to @(AndroidNativeLibrary), which becomes @(EmbeddedNativeLibrary) and is
		packed into HotChai.Bindings.IronSource.Android.aar. The consuming app also receives
		each of those AARs, so every .so would reach the APK twice and trigger XA4301 "APK
		already contains the item" warnings. Removing the imported libraries here leaves the
		AAR that owns each .so as its only source.
	-->
	<Target Name="_RemoveImportedNativeLibrariesFromAar" BeforeTargets="_CreateAarCache">
		<ItemGroup>
			<EmbeddedNativeLibrary Remove="@(ExtractedNativeLibraryImports)" />
		</ItemGroup>
	</Target>
</Project>
