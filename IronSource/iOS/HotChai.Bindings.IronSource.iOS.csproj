<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <PropertyGroup>
        <Version>9.4.1.0-Alpha8</Version>
        <Title>$(AssemblyName)</Title>
        <RepositoryUrl>https://github.com/hotchaipro/HotChai.Bindings</RepositoryUrl>
        <Authors>David Taylor</Authors>
        <Company>Hot Chai Games</Company>
        <Description>.NET for iOS bindings for the ironSource SDK</Description>
        <PackageProjectUrl>https://github.com/hotchaipro/HotChai.Bindings</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageOutputPath>../../../LocalPackages</PackageOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
        <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- IronSource SDK -->
        <NativeReference Include="Pods\IronSourceSDK\IronSource\IronSource.xcframework">
            <Kind>Framework</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lz</LinkerFlags>
            <Frameworks>AVFoundation AdSupport AudioToolbox CFNetwork CoreGraphics CoreMedia CoreTelephony CoreVideo Foundation MobileCoreServices QuartzCore Security StoreKit SystemConfiguration</Frameworks>
        </NativeReference>
    </ItemGroup>

