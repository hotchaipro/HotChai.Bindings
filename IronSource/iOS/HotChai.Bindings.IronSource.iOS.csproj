<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <!--
          iOS 15.0 minimum. The mediation adapters bundled with this package
          (Google Mobile Ads / AdMob, Unity Ads, Vungle, etc.) are Swift SDKs
          that use async/await. The Swift Concurrency runtime first shipped
          inside iOS in 15.0. Targeting an earlier OS forces the linker to use
          the back-deployment concurrency runtime, which must then be embedded
          in the consuming app; on iOS 15+ devices that produces TWO copies of
          the concurrency runtime and crashes at startup. Building the package
          for ios15.0 makes NuGet reject consumers that target an earlier OS.
        -->
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <!--
      Ship MSBuild props/targets inside the package so consumers automatically
      get the configuration required to avoid the startup crash:
        * LinkWithSwiftSystemLibraries is forced on (props).
        * The deployment target is validated to be iOS 15.0+ with a clear,
          actionable error (targets).
      Files live in buildTransitive/ (applied to direct AND transitive package
      references); build/ simply forwards to them for older NuGet clients.
    -->
    <ItemGroup>
        <None Include="buildTransitive\$(MSBuildProjectName).props" Pack="true" PackagePath="buildTransitive\" />
        <None Include="buildTransitive\$(MSBuildProjectName).targets" Pack="true" PackagePath="buildTransitive\" />
        <None Include="build\$(MSBuildProjectName).props" Pack="true" PackagePath="build\" />
        <None Include="build\$(MSBuildProjectName).targets" Pack="true" PackagePath="build\" />
    </ItemGroup>

    <PropertyGroup>
        <Version>9.7.0.0</Version>
        <Title>$(AssemblyName)</Title>
        <RepositoryUrl>https://github.com/hotchaipro/HotChai.Bindings</RepositoryUrl>
        <Authors>David Taylor</Authors>
        <Company>Hot Chai Games</Company>
        <Description>.NET for iOS bindings for the ironSource SDK</Description>
        <PackageProjectUrl>https://github.com/hotchaipro/HotChai.Bindings</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageOutputPath>../../../LocalPackages</PackageOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          Mediation adapters that can be left out of the package (with their
          network SDKs) by setting these to false at build time.
        -->
        <EnableIronSourceUnityAdsAdapter>true</EnableIronSourceUnityAdsAdapter>
        <EnableIronSourceVungleAdapter>true</EnableIronSourceVungleAdapter>
        <EnableIronSourceAdMobAdapter>true</EnableIronSourceAdMobAdapter>
    </PropertyGroup>

    <ItemGroup>
        <!-- Generated by build.sh -->
        <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
        <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
        <ObjcBindingCoreSource Include="BgenDelegates.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HotChai.Bindings.Google.UserMessagingPlatform" Version="3.1.0" />
    </ItemGroup>

    <!--
      The native SDKs: NativeDependencies\Package.swift pins them, and its
      update.sh copies them to NativeDependencies\Frameworks. The adapters and
      most network SDKs are static; AppLovin, Meta Audience Network, InMobi and
      Vungle ship dynamic frameworks, which are embedded in the app.
    -->
    <PropertyGroup>
        <_NativeFrameworksDir>NativeDependencies\Frameworks\</_NativeFrameworksDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- LevelPlay SDK -->
        <NativeReference Include="$(_NativeFrameworksDir)IronSource.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lz</LinkerFlags>
            <Frameworks>AVFoundation AdSupport AudioToolbox CFNetwork CoreGraphics CoreMedia CoreTelephony CoreVideo Foundation JavaScriptCore MobileCoreServices QuartzCore Security StoreKit SystemConfiguration WebKit</Frameworks>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)IronSourceAdQualitySDK.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lsqlite3.0 -lz</LinkerFlags>
            <Frameworks>AdSupport JavaScriptCore SystemConfiguration WebKit</Frameworks>
        </NativeReference>

        <!-- AdMob -->
        <NativeReference Include="$(_NativeFrameworksDir)ISAdMobAdapter.xcframework" Condition="'$(EnableIronSourceAdMobAdapter)' == 'true'">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)GoogleMobileAds.xcframework" Condition="'$(EnableIronSourceAdMobAdapter)' == 'true'">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>

        <!-- AppLovin -->
        <NativeReference Include="$(_NativeFrameworksDir)ISAppLovinAdapter.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)AppLovinSDK.xcframework">
            <Kind>Framework</Kind>
            <WeakFrameworks>AppTrackingTransparency</WeakFrameworks>
        </NativeReference>

        <!-- Meta Audience Network -->
        <NativeReference Include="$(_NativeFrameworksDir)ISFacebookAdapter.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)FBAudienceNetwork.xcframework">
            <Kind>Framework</Kind>
        </NativeReference>

        <!-- Digital Turbine (Fyber) -->
        <NativeReference Include="$(_NativeFrameworksDir)ISFyberAdapter.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)IASDKCore.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lxml2.2</LinkerFlags>
        </NativeReference>

        <!-- InMobi -->
        <NativeReference Include="$(_NativeFrameworksDir)ISInMobiAdapter.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)InMobiSDK.xcframework">
            <Kind>Framework</Kind>
            <LinkerFlags>-lsqlite3.0</LinkerFlags>
        </NativeReference>

        <!-- Mintegral -->
        <NativeReference Include="$(_NativeFrameworksDir)ISMintegralAdapter.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)MTGSDK.xcframework;$(_NativeFrameworksDir)MTGSDKBanner.xcframework;$(_NativeFrameworksDir)MTGSDKBidding.xcframework;$(_NativeFrameworksDir)MTGSDKInterstitialVideo.xcframework;$(_NativeFrameworksDir)MTGSDKNativeAdvanced.xcframework;$(_NativeFrameworksDir)MTGSDKNewInterstitial.xcframework;$(_NativeFrameworksDir)MTGSDKReward.xcframework;$(_NativeFrameworksDir)MTGSDKSplash.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lsqlite3 -lxml2 -lz</LinkerFlags>
        </NativeReference>

        <!-- Pangle -->
        <NativeReference Include="$(_NativeFrameworksDir)ISPangleAdapter.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lc++abi</LinkerFlags>
            <Frameworks>AVFoundation Accelerate AdSupport AudioToolbox CFNetwork CoreGraphics CoreImage CoreMedia CoreMotion CoreTelephony CoreVideo Foundation JavaScriptCore MediaPlayer MobileCoreServices QuartzCore Security StoreKit SystemConfiguration UIKit WebKit</Frameworks>
            <WeakFrameworks>AppTrackingTransparency CoreML DeviceCheck</WeakFrameworks>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)PAGAdSDK.xcframework;$(_NativeFrameworksDir)TikTokBusinessSDK.xcframework">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC -lbz2 -lc++ -lc++abi -liconv -lresolv -lsqlite3 -lxml2 -lz</LinkerFlags>
            <Frameworks>AVFoundation Accelerate AdSupport AudioToolbox CoreImage CoreMedia CoreMotion CoreTelephony JavaScriptCore MediaPlayer MobileCoreServices Security StoreKit SystemConfiguration UIKit WebKit</Frameworks>
            <WeakFrameworks>AppTrackingTransparency CoreML DeviceCheck</WeakFrameworks>
        </NativeReference>

        <!-- Unity Ads -->
        <NativeReference Include="$(_NativeFrameworksDir)ISUnityAdsAdapter.xcframework;$(_NativeFrameworksDir)UnityAds.xcframework" Condition="'$(EnableIronSourceUnityAdsAdapter)' == 'true'">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>

        <!-- Vungle -->
        <NativeReference Include="$(_NativeFrameworksDir)ISVungleAdapter.xcframework" Condition="'$(EnableIronSourceVungleAdapter)' == 'true'">
            <Kind>Static</Kind>
            <ForceLoad>true</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
        <NativeReference Include="$(_NativeFrameworksDir)VungleAdsSDK.xcframework" Condition="'$(EnableIronSourceVungleAdapter)' == 'true'">
            <Kind>Framework</Kind>
            <WeakFrameworks>WebKit</WeakFrameworks>
        </NativeReference>
    </ItemGroup>

    <!--
      NativeDependencies\Frameworks and \Resources aren't committed (several SDK
      binaries exceed GitHub's file size limit): update.sh downloads them, and
      runs here whenever they're missing or older than Package.swift or
      Package.resolved. It needs macOS and Xcode's swift.
    -->
    <PropertyGroup>
        <_NativeDependenciesStamp>NativeDependencies\Frameworks\.stamp</_NativeDependenciesStamp>
    </PropertyGroup>

    <Target Name="_UpdateIronSourceNativeDependencies"
            BeforeTargets="BeforeBuild"
            Inputs="NativeDependencies\Package.swift;NativeDependencies\Package.resolved;NativeDependencies\update.sh"
            Outputs="$(_NativeDependenciesStamp)">
        <Error Condition="!$([MSBuild]::IsOSPlatform('OSX'))"
               Text="The ironSource native dependencies aren't downloaded. Run IronSource/iOS/NativeDependencies/update.sh on a Mac." />
        <Exec Command="&quot;$(MSBuildProjectDirectory)/NativeDependencies/update.sh&quot;" />
        <Touch Files="$(_NativeDependenciesStamp)" AlwaysCreate="true" />
    </Target>

    <!--
      Resource bundles the SDKs read at runtime (assets, scripts, privacy
      manifests): update.sh collects them in NativeDependencies\Resources, since
      static frameworks don't bring their bundles into the app. Added after the
      update, since a fresh clone has none when the project is evaluated.
    -->
    <Target Name="_AddIronSourceResourceBundles"
            AfterTargets="_UpdateIronSourceNativeDependencies"
            BeforeTargets="BeforeBuild">
        <ItemGroup>
            <_IronSourceResource Include="NativeDependencies\Resources\**\*" />
            <_IronSourceResource Remove="NativeDependencies\Resources\GoogleMobileAdsResources.bundle\**;NativeDependencies\Resources\UserMessagingPlatformResources.bundle\**" Condition="'$(EnableIronSourceAdMobAdapter)' != 'true'" />
            <_IronSourceResource Remove="NativeDependencies\Resources\UnityAdsResources.bundle\**;NativeDependencies\Resources\UnityCoherenceLib.bundle\**" Condition="'$(EnableIronSourceUnityAdsAdapter)' != 'true'" />
            <_IronSourceResource Remove="NativeDependencies\Resources\VungleAds.bundle\**" Condition="'$(EnableIronSourceVungleAdapter)' != 'true'" />
            <BundleResource Include="@(_IronSourceResource)">
                <LogicalName>%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
            </BundleResource>
        </ItemGroup>
    </Target>
</Project>
