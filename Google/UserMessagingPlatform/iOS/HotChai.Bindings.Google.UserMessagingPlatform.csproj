<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <IsBindingProject>true</IsBindingProject>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <PropertyGroup>
        <Version>3.1.0.0</Version>
        <Title>$(AssemblyName)</Title>
        <RepositoryUrl>https://github.com/hotchaipro/HotChai.Bindings</RepositoryUrl>
        <Authors>David Taylor</Authors>
        <Company>Hot Chai Games</Company>
        <Description>.NET for iOS bindings for the Google User Messaging Platform SDK</Description>
        <PackageProjectUrl>https://github.com/hotchaipro/HotChai.Bindings</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageOutputPath>../../../../LocalPackages</PackageOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
        <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
        <!-- bgen-only delegate hints: visible to bgen for type resolution,
             excluded from C# compilation (bgen auto-generates these in SupportDelegates.g.cs) -->
        <ObjcBindingCoreSource Include="BgenDelegates.cs" Condition="Exists('BgenDelegates.cs')" />
    </ItemGroup>

    <!-- Remove bgen-only delegate hints from C# compilation.
         The SDK's ObjCBinding targets add ObjcBindingCoreSource to Compile,
         but these delegates conflict with bgen's auto-generated SupportDelegates.g.cs. -->
    <Target Name="_RemoveBgenDelegatesFromCompile" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Compile Remove="BgenDelegates.cs" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <NativeReference Include="Native\UserMessagingPlatform.xcframework">
            <Kind>Framework</Kind>
            <SmartLink>False</SmartLink>
            <ForceLoad>True</ForceLoad>
            <LinkerFlags>-ObjC</LinkerFlags>
        </NativeReference>
    </ItemGroup>
</Project>
