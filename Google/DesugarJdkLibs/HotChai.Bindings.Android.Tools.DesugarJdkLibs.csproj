<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android36</TargetFramework>
		<SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsTrimmable>true</IsTrimmable>
		<Version>2.1.5</Version>
		<Title>$(AssemblyName)</Title>
		<RepositoryUrl>https://github.com/hotchaipro/HotChai.Bindings</RepositoryUrl>
		<Authors>David Taylor</Authors>
		<Company>Hot Chai Games</Company>
		<Description>.NET for Android bindings for the Android Java library 'com.android.tools.desugar_jdk_libs'</Description>
		<PackageProjectUrl>https://github.com/hotchaipro/HotChai.Bindings</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageOutputPath>$(SolutionDir)..\..\LocalPackages\</PackageOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<AndroidMavenLibrary Include="com.android.tools:desugar_jdk_libs" Version="2.1.5" Repository="Google" Bind="false" Pack="true" />
		<AndroidMavenLibrary Include="com.android.tools:desugar_jdk_libs_configuration" Version="2.1.5" Repository="Google" Bind="false" Pack="true" />
	</ItemGroup>
</Project>
